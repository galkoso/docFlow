# Synthetic local development only; supply managed secrets for deployed systems.
DATABASE_URL=postgres://specspace:local-development-only@127.0.0.1:54329/specspace
APP_LISTEN_ADDRESS=127.0.0.1:3000
# Two durable search-index workers run with the API; allowed timeout: 30–3600 seconds.
INDEX_WORKER_TIMEOUT_SECONDS=900
# One proposal provisioning worker; allowed timeout: 30–3600 seconds.
PROPOSAL_WORKER_TIMEOUT_SECONDS=120
SAVE_WORKER_TIMEOUT_SECONDS=900
# Explicit recovery policy (1–365 days). Unset disables server recovery writes.
# The organization must approve its production retention policy before real use.
DRAFT_RETENTION_DAYS=30
APP_ENV=development
APP_PUBLIC_URL=http://localhost:4200
# Set these only for your configured identity provider; never commit real secrets.
# OIDC_ISSUER=https://identity.example
# OIDC_CLIENT_ID=specspace
# OIDC_CLIENT_SECRET=resolve-from-your-secret-provider
# GIT_PROVIDER=github
# GITHUB_APP_ID=your-app-or-client-id
# GITHUB_PRIVATE_KEY_SECRET_REF=file:/run/secrets/github-app.pem
