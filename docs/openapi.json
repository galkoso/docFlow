  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message_he",
          "trace_id",
          "retryable",
          "field_errors"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {},
          "field_errors": {},
          "message_he": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "trace_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AuthAvailability": {
        "type": "object",
        "required": [
          "login_available"
        ],
        "properties": {
          "login_available": {
            "type": "boolean"
          }
        }
      },
      "DocumentBlock": {
        "type": "object",
        "required": [
          "block_id",
          "section_id",
          "kind",
          "text",
          "source_start_byte",
          "source_end_byte"
        ],
        "properties": {
          "block_id": {
            "type": "string"
          },
          "heading_level": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "kind": {
            "type": "string"
          },
          "section_id": {
            "type": "string"
          },
          "source_end_byte": {
            "type": "integer",
            "minimum": 0
          },
          "source_start_byte": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string"
          }
        }
      },
      "DocumentResponse": {
        "type": "object",
        "required": [
          "snapshot_sha",
          "document_id",
          "title",
          "blocks"
        ],
        "properties": {
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentBlock"
            }
          },
          "document_id": {
            "type": "string"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "markdown": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot_sha": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "DocumentSummary": {
        "type": "object",
        "required": [
          "document_id",
          "path",
          "title",
          "sections"
        ],
        "properties": {
          "document_id": {
            "type": "string"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SectionSummary"
            }
          },
          "title": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Membership": {
        "type": "object",
        "required": [
          "organization_id",
          "role",
          "review_domains"
        ],
        "properties": {
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "review_domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "type": "string"
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "user_id",
          "display_name",
          "memberships",
          "capabilities"
        ],
        "properties": {
          "capabilities": {
            "$ref": "#/components/schemas/ProfileCapabilities"
          },
          "display_name": {
            "type": "string"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ProfileCapabilities": {
        "type": "object",
        "required": [
          "read_specification",
          "create_proposal",
          "review",
          "merge",
          "manage_policy"
        ],
        "properties": {
          "create_proposal": {
            "type": "boolean"
          },
          "manage_policy": {
            "type": "boolean"
          },
          "merge": {
            "type": "boolean"
          },
          "read_specification": {
            "type": "boolean"
          },
          "review": {
            "type": "boolean"
          }
        }
      },
      "ReadFinding": {
        "type": "object",
        "required": [
          "path",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "source_end_byte": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "source_start_byte": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "RepositoryList": {
        "type": "object",
        "required": [
          "repositories"
        ],
        "properties": {
          "repositories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RepositorySummary"
            }
          }
        }
      },
      "RepositorySummary": {
        "type": "object",
        "required": [
          "repository_id",
          "default_branch"
        ],
        "properties": {
          "default_branch": {
            "type": "string"
          },
          "repository_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SearchHit": {
        "type": "object",
        "required": [
          "match_id",
          "document_id",
          "section_id",
          "block_id",
          "start_utf16",
          "end_utf16",
          "excerpt",
          "book_order"
        ],
        "properties": {
          "block_id": {
            "type": "string"
          },
          "book_order": {
            "type": "integer",
            "minimum": 0
          },
          "document_id": {
            "type": "string"
          },
          "end_utf16": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "excerpt": {
            "type": "string"
          },
          "match_id": {
            "type": "string"
          },
          "section_id": {
            "type": "string"
          },
          "start_utf16": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "required": [
          "query",
          "snapshot_sha",
          "total_matches",
          "matches"
        ],
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "query": {
            "type": "string"
          },
          "snapshot_sha": {
            "type": "string"
          },
          "total_matches": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SectionSummary": {
        "type": "object",
        "required": [
          "section_id",
          "title",
          "level"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "section_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "Specification": {
        "type": "object",
        "required": [
          "branch",
          "repository_id",
          "snapshot_sha",
          "version_selected",
          "updated_at",
          "documents",
          "findings"
        ],
        "properties": {
          "branch": {
            "type": "string"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentSummary"
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReadFinding"
            }
          },
          "repository_id": {
            "type": "string",
            "format": "uuid"
          },
          "snapshot_sha": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "version_selected": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-specspace-session"
      }
    }
  }
}
